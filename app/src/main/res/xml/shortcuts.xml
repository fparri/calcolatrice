<?xml version="1.0" encoding="utf-8"?>
<!--
    Scorciatoie che compaiono tenendo premuta l'icona dell'app.
    Aprono MainActivity (l'unica schermata esportata) con un'azione, e MainActivity passa
    alla schermata richiesta. targetPackage deve coincidere con applicationId in app/build.gradle.kts.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_equations"
        android:shortcutId="equations"
        android:shortcutLongLabel="@string/equations"
        android:shortcutShortLabel="@string/shortcut_equations_short">
        <intent
            android:action="io.github.calcolatrice.action.EQUATIONS"
            android:targetClass="io.github.calcolatrice.MainActivity"
            android:targetPackage="io.github.calcolatrice" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_statistics"
        android:shortcutId="statistics"
        android:shortcutLongLabel="@string/statistics"
        android:shortcutShortLabel="@string/shortcut_statistics_short">
        <intent
            android:action="io.github.calcolatrice.action.STATISTICS"
            android:targetClass="io.github.calcolatrice.MainActivity"
            android:targetPackage="io.github.calcolatrice" />
    </shortcut>
</shortcuts>
